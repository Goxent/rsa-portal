rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================
    // HELPER FUNCTIONS & AUTHENTICATION
    // ========================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ? getUserDoc().role : 'STAFF';
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'MASTER_ADMIN');
    }

    function isMasterAdmin() {
      return isAuthenticated() && getUserRole() == 'MASTER_ADMIN';
    }

    // S1 Fix: Approved / Active user check
    // Restricts sensitive org reads (tasks, clients, attendance, docs) to verified Active users
    function isApproved() {
      return isAuthenticated() && userExists() && getUserDoc().get('status', '') == 'Active';
    }

    // Security & Validation Helpers
    function isString(val) { return val is string; }
    function isSafeString(val, maxLen) { return isString(val) && val.size() <= maxLen; }
    function checkKeys(requiredKeys) { return request.resource.data.keys().hasAll(requiredKeys); }

    // Protected user profile fields that only ADMIN/MASTER_ADMIN can set/change
    function protectedUserFields() {
      return ['role', 'status', 'isOnboardingComplete', 'isSetupComplete', 'taskCreationAuthorized', 'complianceCreationAuthorized'];
    }

    // Returns true for admins, managers, or users granted explicit task-creation authorization
    function canCreateTask() {
      return isApproved() && (
        getUserRole() == 'ADMIN' ||
        getUserRole() == 'MASTER_ADMIN' ||
        getUserRole() == 'MANAGER' ||
        getUserDoc().get('taskCreationAuthorized', false) == true
      );
    }

    // AD2: Helper to verify upload/creation permission for audit documentation files and folders
    function canCreateAuditDoc() {
      return isApproved() &&
        request.resource.data.createdBy == request.auth.uid && (
          isAdmin() ||
          getUserRole() == 'MANAGER' ||
          (
            request.resource.data.clientId is string &&
            exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId)) &&
            request.auth.uid in get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.get('permittedStaff', [])
          )
        );
    }


    // ========================================================
    // AUDIT LOGS (AL1 Fix)
    // Only admins can read. Users can only write logs where actorId or userId matches their auth.uid
    // ========================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.get('actorId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // ========================================================
    // USERS COLLECTION (S1 & S2 Fixes)
    // - Non-admins cannot alter their role, status, or authorization flags
    // - Only MASTER_ADMIN can assign ADMIN or MASTER_ADMIN role
    // - Only MASTER_ADMIN or ADMIN can delete pending/invited placeholder records
    // ========================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        // Self-creation during signup: must default to STAFF and cannot self-approve
        (request.auth.uid == userId 
          && (!request.resource.data.keys().hasAny(protectedUserFields()) || 
              (request.resource.data.get('role', 'STAFF') == 'STAFF' && request.resource.data.get('status', 'Pending Approval') == 'Pending Approval'))
        ) ||
        // Admin creation: Only Master Admin can assign ADMIN or MASTER_ADMIN
        (isAdmin() && (
          !request.resource.data.keys().hasAny(['role']) ||
          request.resource.data.role in ['STAFF', 'MANAGER'] ||
          isMasterAdmin()
        ))
      );

      allow update: if isAuthenticated() && (
        // Regular user updating their own profile: cannot touch protected fields
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())) ||
        // Admin update: Only Master Admin can grant ADMIN or MASTER_ADMIN roles
        (isAdmin() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          (request.resource.data.role in ['STAFF', 'MANAGER'] && resource.data.get('role', '') in ['STAFF', 'MANAGER']) ||
          isMasterAdmin()
        ))
      );

      // Only Master Admin can delete real users; Admins can delete pending/invited placeholders
      allow delete: if isAuthenticated() && (
        isMasterAdmin() || 
        (isAdmin() && (userId.matches('^pending_.*') || userId.matches('^invited_.*')))
      );

      match /settings/{settingId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ========================================================
    // STAFF ALLOWLIST
    // ========================================================
    match /staffAllowlist/{email} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================================
    // CLIENTS COLLECTION (C1 & C2 Fixes)
    // - Read: Admin OR (Approved AND (Manager OR permittedStaff))
    // - Update: Admin OR (Approved AND permittedStaff AND documents/updatedAt only)
    // ========================================================
    match /clients/{clientId} {
      allow read: if isAdmin() || (
        isApproved() && (
          getUserRole() == 'MANAGER' ||
          request.auth.uid in resource.data.get('permittedStaff', [])
        )
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isApproved() &&
        request.auth.uid in resource.data.get('permittedStaff', []) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents', 'updatedAt'])
      );
    }

    // ========================================================
    // ATTENDANCE COLLECTION (A1-A5 & S5 Fixes)
    // Update checks EXISTING resource.data.userId to prevent tampering
    // ========================================================
    match /attendance/{attendanceId} {
      allow read: if isApproved();
      allow create: if isAuthenticated() && 
                    (request.auth.uid == request.resource.data.userId || isAdmin()) &&
                    checkKeys(['userId', 'date', 'status']) &&
                    isSafeString(request.resource.data.userId, 128);
      allow update: if isAuthenticated() && 
                    (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ATTENDANCE REQUESTS
    match /attendanceRequests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }
    
    // ========================================================
    // LEAVE REQUESTS (L1-L3 & S5 Fixes)
    // ========================================================
    match /leaves/{leaveId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == resource.data.userId &&
          resource.data.status == 'PENDING' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt'])
        )
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // ========================================================
    // TASKS COLLECTION (W1-W3 Governance)
    // ========================================================
    match /tasks/{taskId} {
      allow read: if isApproved();
      allow create: if canCreateTask();
      
      allow update: if isApproved() && (
        request.auth.uid in resource.data.assignedTo ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid == resource.data.get('teamLeaderId', '') ||
        isAdmin() ||
        getUserRole() == 'MANAGER'
      ) && (
        // 1. ARCHIVED LOCKDOWN: Archived tasks cannot be edited by anyone
        resource.data.get('status', '') != 'ARCHIVED'
      ) && (
        // 2. GOVERNANCE LOCKDOWN: Completed tasks in Review & Conclusion can only be reopened by Admin
        (!(resource.data.status == 'COMPLETED' && resource.data.auditPhase == 'REVIEW_AND_CONCLUSION' && request.resource.data.status != 'COMPLETED') || isAdmin())
      ) && (
        // 3. SIGN-OFF PROTECTION: Only designated roles or Admins can sign off
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamLeadApprovedAt'])) ||
        (request.auth.uid == resource.data.get('teamLeaderId', '') || isAdmin())
      ) && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['engagementReviewerApprovedAt'])) ||
        (request.auth.uid == resource.data.get('engagementReviewerId', '') || isAdmin())
      ) && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['signingPartnerApprovedAt'])) ||
        (request.auth.uid == resource.data.get('signingPartnerId', '') || isAdmin())
      ) && (
        // 4. COMPLETION GATE: Enforce sign-offs before status becomes COMPLETED
        (request.resource.data.get('status', '') != 'COMPLETED') ||
        (isAdmin() || (
            resource.data.get('teamLeadApprovedAt', '') != '' &&
            resource.data.get('engagementReviewerApprovedAt', '') != '' &&
            resource.data.get('signingPartnerApprovedAt', '') != ''
        ))
      );
      
      allow delete: if isAdmin();
    }

    // ========================================================
    // NOTIFICATIONS
    // ========================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'ALL');
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow delete, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ========================================================
    // NOTICES & NOTICE READS (CM1 Fix)
    // ========================================================
    match /notices/{noticeId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /noticeReads/{readId} {
      allow read: if isApproved();
      allow create, update: if isApproved() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAdmin();
    }
    
    // TEMPLATES & WORKFLOWS (Only Admin & Managers can edit)
    match /templates/{templateId} {
      allow read: if isApproved();
      allow create, update: if isAdmin() || getUserRole() == 'MANAGER';
      allow delete: if isAdmin();
    }

    match /task_templates/{templateId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() || getUserRole() == 'MANAGER';
    }
    
    match /template_folders/{folderId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() || getUserRole() == 'MANAGER';
    }
    
    match /workflows/{workflowId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() || getUserRole() == 'MANAGER';
    }

    // TIME TRACKING
    match /timeEntries/{entryId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // COMPLIANCE EVENTS
    match /complianceEvents/{eventId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // SMART REMINDERS
    match /smart_reminders/{reminderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reminder_preferences/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // KNOWLEDGE BASE / RESOURCES
    match /knowledge_base/{resourceId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() || getUserRole() == 'MANAGER';
    }

    match /resources/{resourceId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin() || getUserRole() == 'MANAGER';
    }

    match /resource_categories/{categoryId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ========================================================
    // EVENTS (CA1 Fix)
    // - Read allowed if approved AND (PUBLIC, creator, Admin, TEAM member, or DEPARTMENT match)
    // ========================================================
    match /events/{eventId} {
      allow read: if isApproved() && (
        resource.data.get('visibility', 'PUBLIC') == 'PUBLIC' ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        isAdmin() ||
        (resource.data.get('visibility', '') == 'TEAM' && request.auth.uid in resource.data.get('teamIds', [])) ||
        (resource.data.get('visibility', '') == 'DEPARTMENT' && getUserDoc().get('department', '') == resource.data.get('department', ''))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ========================================================
    // AUDIT DOCUMENTATION (AD2 Fix)
    // - Create: Must be approved, createdBy == auth.uid, and either Admin, Manager, or client permitted staff
    // - Read: approved users
    // - Update: creator or Admin
    // - Delete: Admin only
    // ========================================================
    match /auditDocFiles/{fileId} {
      allow read: if isApproved();
      allow create: if canCreateAuditDoc();
      allow update: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /auditDocFolders/{folderId} {
      allow read: if isApproved();
      allow create: if canCreateAuditDoc();
      allow update: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
